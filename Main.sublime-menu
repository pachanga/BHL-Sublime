[
	{
		"caption": "Preferences",
		"mnemonic": "n",
		"id": "preferences",
		"children": [
			{
				"caption": "Package Settings",
				"mnemonic": "P",
				"id": "package-settings",
				"children": [
					{
						"caption": "BHL",
						"children": [
							{
								"caption": "Settings",
								"command": "edit_settings",
								"args": {
									"base_file": "${packages}/BHL-Sublime/LSP-bhl.sublime-settings",
									"default": "// Settings in here override those in \"BHL-Sublime/LSP-bhl.sublime-settings\"\n\n{\n\t$0\n}\n"
								}
							}
						]
					}
				]
			}
		]
	}
]
